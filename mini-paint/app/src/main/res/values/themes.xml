<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by day; values-night switches to the dark theme so the page's own
         prefers-color-scheme dark mode follows the phone setting. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/bar_bg</item>
    </style>
</resources>
